{
  "name": "meganemaru-blog",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/media/cms/*",
      "/data/posts.json",
      "/blog/article",
      "/blog/article.html",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meganemaru-blog-db",
      "database_id": "b574fbc9-2248-47b0-98cb-6c4cfb7265a0"
    }
  ],
  "triggers": {
    "crons": [
      "0 22 * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CMS_IMAGES",
      "id": "dbcd790eee76479587266d24dc6406f0"
    }
  ]
}
