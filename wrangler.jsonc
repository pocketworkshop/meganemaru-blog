{
  "name": "meganemaru-blog",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meganemaru-blog-db",
      "database_id": "b574fbc9-2248-47b0-98cb-6c4cfb7265a0"
    }
  ]
}
